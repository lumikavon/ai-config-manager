{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Config Manager",
  "version": "0.1.0",
  "identifier": "dev.aiconfig.manager",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "AI Config Manager", "width": 1180, "height": 820, "minWidth": 820, "minHeight": 620, "visible": false, "center": true, "decorations": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'" }
  },
  "bundle": { "active": true, "targets": "all", "category": "DeveloperTool", "shortDescription": "Secure local AI provider configuration", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
